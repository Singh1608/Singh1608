# Copy to .env. Everything is optional; defaults are shown.
TENDER_ENV=dev
TENDER_DATABASE_URL=sqlite:///./tender_ai.db

# --- AI engine ---------------------------------------------------------------
# Set an Anthropic key to use Claude for summarisation and extraction.
# Without one (or with TENDER_LLM_ENABLED=off) the offline extractor is used.
ANTHROPIC_API_KEY=
TENDER_LLM_MODEL=claude-opus-5
TENDER_LLM_ENABLED=auto
TENDER_LLM_MAX_CHARS=400000

# First admin user, created only if the users table is empty.
TENDER_BOOTSTRAP_ADMIN_KEY=

# --- Finance ---------------------------------------------------------------------
TENDER_COST_OF_CAPITAL=0.11
TENDER_BG_COMMISSION=0.015
TENDER_OVERHEAD_PCT=0.08
TENDER_MC_RUNS=5000

# --- Bid / no-bid policy -----------------------------------------------------------
TENDER_MIN_WIN_PROB=0.20
TENDER_MIN_MARGIN=0.06
TENDER_MAX_RISK=70
TENDER_MAX_LOSS_PROB=0.25
TENDER_MIN_PREP_DAYS=7

# --- Delegation of authority -------------------------------------------------------
TENDER_DOA_FINANCE=1000000
TENDER_DOA_EXECUTIVE=10000000
TENDER_LEGAL_RISK=50
